# ── ARAKONAK GES — Kullanıcı hesapları ──
# Bu içeriği Streamlit Cloud'da "Settings → Secrets" alanına yapıştırın
# (veya yerelde .streamlit/secrets.toml olarak kaydedin).
# 'hash' değerlerini uygulamadaki "Ayarlar" sekmesindeki üreteçle oluşturun
# (format: pbkdf2$...$...$... — harici paket gerektirmez).

[auth.users.admin]
name = "Proje Müdürü"
role = "admin"
hash = "BURAYA_PBKDF2_HASH"

[auth.users.saha]
name = "Saha Mühendisi"
role = "admin"
hash = "BURAYA_PBKDF2_HASH"

[auth.users.izleyici]
name = "İşveren / İzleyici"
role = "viewer"
hash = "BURAYA_PBKDF2_HASH"
